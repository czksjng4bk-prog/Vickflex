<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="apple-mobile-web-app-capable" content="yes">
<title>VICKFLEX Descanso</title>
<style>
:root{--v:#2f6b4f;--v2:#e4efe8;--b:#f4efe6;--b2:#e9e0d0;--t:#2b2b2b;--g:#7a7468;--ok:#3d9a5f;--am:#e0a526;--ro:#c9503f}
*{box-sizing:border-box;margin:0}
body{font-family:-apple-system,"Helvetica Neue",sans-serif;background:var(--b);color:var(--t);display:flex;height:100vh}
nav{width:210px;background:#fff;padding:22px 14px;border-right:1px solid var(--b2);display:flex;flex-direction:column;gap:6px}
.logo{font-weight:700;color:var(--v);font-size:20px;line-height:1.1;margin-bottom:18px}
.logo small{display:block;font-weight:400;font-size:12px;color:var(--g);letter-spacing:2px}
nav button{border:0;background:none;text-align:left;padding:13px 14px;border-radius:12px;font-size:16px;color:var(--t)}
nav button.on{background:var(--v2);color:var(--v);font-weight:600}
nav button.off{color:#b5afa3}
main{flex:1;overflow:auto;padding:26px 30px}
h1{font-size:26px;color:var(--v)} .sub{color:var(--g);margin:2px 0 20px}
.grid{display:grid;gap:16px}
.k{grid-template-columns:repeat(4,1fr)}
.c2{grid-template-columns:1.4fr 1fr}
.c3{grid-template-columns:1fr 1fr 1fr}
.card{background:#fff;border-radius:18px;padding:18px 20px;box-shadow:0 2px 10px rgba(80,60,20,.07)}
.card h3{font-size:14px;color:var(--g);font-weight:600;text-transform:uppercase;letter-spacing:.6px;margin-bottom:12px}
.big{font-size:30px;font-weight:700}
.up{color:var(--ok)} .dn{color:var(--ro)}
.row{display:flex;justify-content:space-between;align-items:center;padding:9px 0;border-bottom:1px solid #f0ebe0;font-size:15px}
.row:last-child{border:0}
.pill{padding:3px 10px;border-radius:20px;font-size:13px;font-weight:600}
.pill.u{background:#e3f3e8;color:var(--ok)} .pill.d{background:#fbe6e2;color:var(--ro)}
.bars{display:flex;align-items:flex-end;gap:8px;height:150px}
.bars div{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;height:100%;font-size:11px;color:var(--g)}
.bars span{display:flex;gap:2px;align-items:flex-end;width:100%;justify-content:center;flex:1}
.bars i{width:42%;border-radius:4px 4px 0 0;display:block}
.a25{background:var(--b2)} .a26{background:var(--v)}
.leg{font-size:12px;color:var(--g);margin-top:8px}
.leg b{display:inline-block;width:10px;height:10px;border-radius:3px;margin:0 4px 0 10px}
.zona{background:var(--v);color:#fff}
.zona h3{color:#cfe3d7} .zona .big{font-size:24px}
.zona p{margin-top:8px;color:#e4efe8;font-size:15px;line-height:1.5}
.task{display:flex;gap:10px;padding:9px 0;font-size:15px;align-items:center}
.task input{width:20px;height:20px;accent-color:var(--v)}
.task input:checked+span{text-decoration:line-through;color:#aaa}
.sem{width:18px;height:18px;border-radius:50%;display:inline-block}
.head{display:flex;align-items:center;gap:16px;margin-bottom:18px}
.head .sem{width:34px;height:34px}
.tag{background:var(--v2);color:var(--v);padding:6px 12px;border-radius:20px;font-size:14px;margin:0 6px 6px 0;display:inline-block}
.hist{border-left:3px solid var(--v2);padding-left:12px;margin-bottom:12px;font-size:14px;line-height:1.45}
.hist b{color:var(--v)}
.view{display:none}.view.on{display:block}
</style>
</head>
<body>
<nav>
  <div class="logo">VICKFLEX<small>DESCANSO</small></div>
  <button class="on" onclick="ir('panel',this)">Panel</button>
  <button onclick="ir('ficha',this)">Ficha de cliente</button>
  <button class="off">Representantes</button>
  <button class="off">Planificación</button>
</nav>
<main>

<section id="panel" class="view on">
  <h1>Buenos días</h1>
  <p class="sub">Miércoles 14 de octubre de 2026 · Semana 42</p>

  <div class="grid k">
    <div class="card"><h3>Facturación 2026</h3><div class="big" id="f26"></div></div>
    <div class="card"><h3>Mismo periodo 2025</h3><div class="big" id="f25"></div></div>
    <div class="card"><h3>Variación</h3><div class="big up" id="fv"></div></div>
    <div class="card"><h3>Clientes en rojo</h3><div class="big dn">3</div></div>
  </div>

  <div class="grid c2" style="margin-top:16px">
    <div class="card"><h3>Facturación mensual (miles de €)</h3>
      <div class="bars" id="graf"></div>
      <div class="leg"><b class="a25"></b>2025<b class="a26"></b>2026</div>
    </div>
    <div class="card zona"><h3>Zona de esta semana</h3>
      <div class="big">Levante</div>
      <p>Valencia y Castellón<br>6 clientes por visitar · 2 ya visitados<br>Próxima visita: jueves 9:30, Muebles Ortega (Villarreal)</p>
    </div>
  </div>

  <div class="grid c3" style="margin-top:16px">
    <div class="card"><h3>Representantes</h3>
      <div class="row">Carlos M. <span class="pill u">▲ 12%</span></div>
      <div class="row">Laura P. <span class="pill u">▲ 5%</span></div>
      <div class="row">Javier R. <span class="pill d">▼ 9%</span></div>
      <div class="row">Marta S. <span class="pill d">▼ 14%</span></div>
    </div>
    <div class="card"><h3>Han dejado de comprar</h3>
      <div class="row"><span>Descanso Sur<br><small style="color:#999">Málaga</small></span><span class="dn">hace 7 meses</span></div>
      <div class="row"><span>Hogar Levante<br><small style="color:#999">Alicante</small></span><span class="dn">hace 5 meses</span></div>
      <div class="row"><span>Colchones Pérez<br><small style="color:#999">Murcia</small></span><span class="dn">hace 4 meses</span></div>
    </div>
    <div class="card"><h3>Avisos y tareas</h3>
      <label class="task"><input type="checkbox"><span>Enviar tarifa nueva a Ortega</span></label>
      <label class="task"><input type="checkbox"><span>Llamar a Colchones Pérez</span></label>
      <label class="task"><input type="checkbox" checked><span>Confirmar visita en Gandía</span></label>
      <label class="task"><input type="checkbox"><span>Reponer expositor en Castellón</span></label>
    </div>
  </div>
</section>

<section id="ficha" class="view">
  <div class="head">
    <span class="sem" style="background:var(--am)"></span>
    <div><h1>Muebles Hermanos Ortega</h1>
    <p class="sub" style="margin:0">Villarreal, Castellón · Representante: Carlos M.</p></div>
  </div>

  <div class="grid k">
    <div class="card"><h3>Acumulado 2026</h3><div class="big" id="c26"></div></div>
    <div class="card"><h3>Mismo periodo 2025</h3><div class="big" id="c25"></div></div>
    <div class="card"><h3>Variación</h3><div class="big dn" id="cv"></div></div>
    <div class="card"><h3>Última compra</h3><div class="big" style="font-size:24px">6 oct 2026</div></div>
  </div>

  <div class="grid c2" style="margin-top:16px">
    <div class="card"><h3>Facturación mensual (€)</h3>
      <div class="bars" id="gc"></div>
      <div class="leg"><b class="a25"></b>2025<b class="a26"></b>2026</div>
    </div>
    <div class="card"><h3>En exposición ahora</h3>
      <span class="tag">Viscoelástica Nube</span><span class="tag">Muelles Aura</span><span class="tag">Látex Bosque</span>
      <h3 style="margin-top:14px">Compromisos pendientes</h3>
      <label class="task"><input type="checkbox"><span>Enviar tarifa nueva</span></label>
      <label class="task"><input type="checkbox"><span>Reponer 2 expositores</span></label>
    </div>
  </div>

  <div class="grid c2" style="margin-top:16px">
    <div class="card"><h3>Historial de visitas</h3>
      <div class="hist"><b>6 oct 2026</b> · Pedido de 3 colchones Nube. Piden mejor precio en volumen.</div>
      <div class="hist"><b>18 sep 2026</b> · Revisión de exposición. Quieren renovar el escaparate.</div>
      <div class="hist"><b>22 may 2026</b> · Visita comercial. Interés en línea de látex.</div>
    </div>
    <div class="card"><h3>Últimos pedidos</h3>
      <div class="row">06/10/2026<span>1.200 €</span></div>
      <div class="row">18/09/2026<span>3.300 €</span></div>
      <div class="row">22/05/2026<span>3.900 €</span></div>
      <h3 style="margin-top:14px">Observaciones</h3>
      <p style="font-size:14px;line-height:1.5;color:#555">Cliente fiel pero cae en verano. Dueño prefiere visitas por la mañana.</p>
    </div>
  </div>
</section>

</main>
<script>
const eur=n=>n.toLocaleString("es-ES")+" €";
const pct=(a,b)=>((a/b-1)*100).toFixed(1).replace(".",",")+" %";
function barras(id,a25,a26,k){
  const max=Math.max(...a25,...a26),m="EFMAMJJASOND";
  document.getElementById(id).innerHTML=a25.map((v,i)=>`<div><span><i class="a25" style="height:${v/max*100}%"></i>${a26[i]!=null?`<i class="a26" style="height:${a26[i]/max*100}%"></i>`:""}</span>${m[i]}</div>`).join("");
}
// Panel (datos ficticios, en miles €)
const p25=[88,95,110,102,118,96,70,40,105,112,118,142];
const p26=[96,101,118,112,125,104,74,42,110,59];
const s=a=>a.reduce((x,y)=>x+y,0);
const t26=s(p26)*1000,t25=s(p25.slice(0,10))*1000;
f26.textContent=eur(t26);f25.textContent=eur(t25);fv.textContent="▲ "+pct(t26,t25).replace("-","");
barras("graf",p25,p26);
// Ficha cliente
const c25=[3000,3400,3900,3800,4200,3100,2200,1100,3600,3900,4400,5200];
const c26=[3200,2800,4100,3600,3900,2500,1800,900,3300,1200];
const a=s(c26),b=s(c25.slice(0,10));
document.getElementById("c26").textContent=eur(a);document.getElementById("c25").textContent=eur(b);
document.getElementById("cv").textContent="▼ "+pct(a,b).replace("-","");
barras("gc",c25,c26);
function ir(id,btn){
  document.querySelectorAll(".view").forEach(v=>v.classList.remove("on"));
  document.getElementById(id).classList.add("on");
  document.querySelectorAll("nav button").forEach(x=>x.classList.remove("on"));
  btn.classList.add("on");
}
</script>
</body>
</html>